APP_ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/inventory
JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123!
OPERATOR_EMAIL=operator@example.com
OPERATOR_PASSWORD=operator123!

# AWS / LocalStack
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566          # LocalStack (vacío para AWS real)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Secrets Manager
SECRETS_ARN_JWT=prod/jwt-secret
SECRETS_ARN_DB=prod/database-url

# SQS
SQS_QUEUE_URL=http://localhost:4566/000000000000/import-jobs

# S3
S3_BUCKET_IMPORTS=ecommerce-inventory-imports

# Redis / ElastiCache
REDIS_URL=redis://localhost:6379/0

# ECS Deploy
ECS_CLUSTER=production
ECR_REPOSITORY=123456789.dkr.ecr.us-east-1.amazonaws.com/inventory-api
ECS_CLUSTER_ARN=arn:aws:ecs:us-east-1:123456789:cluster/production